# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 实验生成物（由 run_all.sh 重新生成，不纳入版本控制）
agent-sandbox-lab/work/*
!agent-sandbox-lab/work/agent_code.py

# 编辑器 / 系统
.DS_Store
*.swp
.idea/
.vscode/

# Astro 文档站
site/node_modules/
site/dist/
site/.astro/

# 站点正文：由 site/scripts/sync-docs.py 从仓库根 markdown 生成，不入版本库
# （改文档请改仓库根 markdown，然后跑 make site-sync）
site/src/content/docs/

# ./tmp —— 过程性记忆，默认不进版本库（整个目录）
/tmp/
